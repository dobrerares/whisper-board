<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The bubble surface — see ADR-0001. SYSTEM_ALERT_WINDOW grants the
         floating overlay window; FOREGROUND_SERVICE keeps the bubble's
         microphone capture honest under foreground-service requirements;
         FOREGROUND_SERVICE_MICROPHONE is the typed permission required on
         API 34+ for mic-using foreground services. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Whisper Board"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhisperBoard">

        <activity
            android:name=".settings.SettingsActivity"
            android:label="Whisper Board Settings"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WhisperBoardIME"
            android:label="Whisper Board"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Bubble overlay foreground service — hosts the floating window
             that lets the user dictate from anywhere. Standalone mode only;
             the in-place insertion upgrade is issue #7. -->
        <service
            android:name=".bubble.BubbleOverlayService"
            android:label="Whisper Board bubble"
            android:foregroundServiceType="microphone|specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating dictation overlay" />
        </service>

        <!-- Quick Settings tile — alternative summon path. -->
        <service
            android:name=".bubble.BubbleTileService"
            android:label="Whisper Board"
            android:icon="@drawable/ic_mic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Accessibility service for the bubble's *in-place insertion* upgrade.
            Per ADR-0001 this is a pure upgrade — the bubble's standalone mode
            keeps working without it. When granted, the polished transcript is
            written directly into the focused editable field via
            ACTION_SET_TEXT / ACTION_PASTE instead of being auto-copied to the
            clipboard.
        -->
        <service
            android:name=".accessibility.WhisperBoardAccessibilityService"
            android:label="@string/accessibility_service_summary"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
